# Performance and Optimization Environment Variables
# Add these to your .env file

# Redis Configuration for Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DEFAULT=300
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# Performance Monitoring
PERFORMANCE_MONITORING=true
SLOW_REQUEST_THRESHOLD=1000
ERROR_RATE_THRESHOLD=5
MEMORY_USAGE_THRESHOLD=80
PERFORMANCE_ALERTS=true
PERFORMANCE_ALERT_INTERVAL=300000

# Compression Settings
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_BROTLI=true
ENABLE_HTML_MINIFICATION=true
ENABLE_ASSET_OPTIMIZATION=true

# Caching Configuration
ENABLE_API_CACHING=true
CACHE_TTL_EVENTS=300
CACHE_TTL_CLUBS=600
CACHE_TTL_USERS=1800
CACHE_TTL_STATIC_ASSETS=31536000

# Image Optimization
ENABLE_IMAGE_OPTIMIZATION=true
IMAGE_QUALITY_THUMBNAIL=80
IMAGE_QUALITY_MEDIUM=85
IMAGE_QUALITY_LARGE=90
IMAGE_FORMAT_DEFAULT=webp
GENERATE_RESPONSIVE_IMAGES=true
CLOUDINARY_AUTO_OPTIMIZE=true

# Database Optimization
DB_QUERY_MONITORING=true
DB_SLOW_QUERY_THRESHOLD=100
AUTO_CREATE_INDEXES=true
ENABLE_QUERY_OPTIMIZATION=true
DB_CONNECTION_POOL_SIZE=10

# Static Asset Optimization
STATIC_ASSET_CACHING=true
STATIC_ASSET_MAX_AGE=31536000
ENABLE_RESOURCE_HINTS=true
ENABLE_CRITICAL_CSS=true
BUNDLE_OPTIMIZATION=true

# Memory Management
MEMORY_MONITORING=true
MEMORY_LEAK_THRESHOLD=150
GC_MONITORING=true
HEAP_SNAPSHOT_INTERVAL=0

# CDN and External Services
CDN_BASE_URL=
ENABLE_CDN=false
PRELOAD_CRITICAL_RESOURCES=true
DNS_PREFETCH_DOMAINS=fonts.googleapis.com,cdnjs.cloudflare.com

# Development Performance Features
DEV_PERFORMANCE_LOGGING=true
DEV_CACHE_DEBUGGING=false
DEV_BUNDLE_ANALYSIS=false
DEV_MEMORY_PROFILING=false

# Production Optimizations
PROD_AGGRESSIVE_CACHING=true
PROD_COMPRESSION_MAX=9
PROD_MINIFY_ALL=true
PROD_REMOVE_DEBUG=true
PROD_OPTIMIZE_IMAGES=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DB=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_EXTERNAL_SERVICES=true
METRICS_ENDPOINT_ENABLED=true

# Backup and Cleanup
AUTO_CLEANUP_LOGS=true
LOG_RETENTION_DAYS=90
AUTO_CLEANUP_CACHE=true
CACHE_CLEANUP_INTERVAL=86400000
IMAGE_CLEANUP_ENABLED=false

# Rate Limiting (Performance Related)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Session Optimization
SESSION_STORE=redis
SESSION_TTL=86400
SESSION_ROLLING=true
SESSION_SECURE=true