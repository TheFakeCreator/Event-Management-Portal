# =============================================================================
# Production Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=Event Management Portal
NEXT_PUBLIC_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-key-production-64-chars-min

# Database
MONGODB_URI=mongodb://username:password@mongodb:27017/event_management?authSource=admin

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# -----------------------------------------------------------------------------
# Cloudinary Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=event-management-production

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_SERVER_HOST=smtp.your-provider.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-production-email@domain.com
EMAIL_SERVER_PASSWORD=your-production-email-password
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=event-management-frontend

# -----------------------------------------------------------------------------
# Feature Flags (Production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_SENTRY=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
NEXT_PUBLIC_MAX_FILES_PER_UPLOAD=5
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=900000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-mongo-root-password
JWT_SECRET=your-jwt-secret-key-production-256-bit

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your-secure-redis-password

# -----------------------------------------------------------------------------
# Debug Configuration (Disabled in Production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=error