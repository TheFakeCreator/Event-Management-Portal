# =============================================================================
# Production Environment Configuration
# Event Management Portal - Environment Variables Template
# =============================================================================
#
# IMPORTANT: This is a template file. Copy this to .env.production and fill 
# in the actual values. Never commit actual secrets to version control.
#
# Usage: cp .env.production.template .env.production
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME="Event Management Portal"
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.your-domain.com

# =============================================================================
# Database Configuration
# =============================================================================
# MongoDB Configuration
MONGODB_URI=mongodb://mongodb_user:mongodb_password@localhost:27017/event_management?authSource=admin
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=your_strong_mongo_password

# Redis Configuration
REDIS_URL=redis://:redis_password@localhost:6379
REDIS_PASSWORD=your_strong_redis_password

# =============================================================================
# Authentication & Security
# =============================================================================
# NextAuth.js Configuration
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_characters_long

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Session Configuration
SESSION_SECRET=your_session_secret_key_min_32_characters_long

# =============================================================================
# File Storage & CDN
# =============================================================================
# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# =============================================================================
# Email Service Configuration
# =============================================================================
# SMTP Configuration (for production email service)
EMAIL_SERVER_HOST=smtp.your-email-provider.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email_username
EMAIL_SERVER_PASSWORD=your_email_password
EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs
LOG_ROTATION_SIZE=50m
LOG_RETENTION_DAYS=30

# =============================================================================
# Performance & Optimization
# =============================================================================
# Caching Configuration
CACHE_TTL=300
REDIS_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
# SSL Certificate paths (for nginx)
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_PRIVATE_KEY_PATH=/etc/nginx/ssl/private.key

# =============================================================================
# Backup Configuration
# =============================================================================
# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# =============================================================================
# Health Checks & Monitoring
# =============================================================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_ENABLED=true

# =============================================================================
# Development & Debug (Set to false in production)
# =============================================================================
DEBUG_MODE=false
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# =============================================================================
# Security Headers & CORS
# =============================================================================
CORS_ORIGIN=https://your-domain.com
ALLOWED_HOSTS=your-domain.com,api.your-domain.com

# =============================================================================
# External Services
# =============================================================================
# If using external services like Stripe, Twilio, etc.
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# =============================================================================
# Container Orchestration
# =============================================================================
# Docker Swarm or Kubernetes configuration
REPLICA_COUNT=2
MAX_MEMORY=1g
MAX_CPU=1000m

# =============================================================================
# Notes for Production Deployment
# =============================================================================
#
# 1. Generate Strong Secrets:
#    - Use a password manager or openssl rand -base64 32
#    - Ensure all secrets are unique and minimum 32 characters
#
# 2. SSL/TLS Setup:
#    - Obtain valid SSL certificates (Let's Encrypt, etc.)
#    - Configure nginx with proper SSL settings
#
# 3. Database Security:
#    - Use strong passwords for database users
#    - Configure proper network security groups
#    - Enable database encryption at rest
#
# 4. Monitoring:
#    - Set up alerts for critical metrics
#    - Configure log aggregation and analysis
#    - Monitor resource usage and scaling needs
#
# 5. Backup Strategy:
#    - Test restore procedures regularly
#    - Implement automated backup verification
#    - Store backups in multiple geographic locations
#
# =============================================================================