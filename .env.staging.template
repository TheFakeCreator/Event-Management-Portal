# =============================================================================
# Staging Environment Configuration
# Event Management Portal - Copy this file to .env.staging and configure
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Info
NEXT_PUBLIC_APP_NAME="Event Management Portal (Staging)"
NEXT_PUBLIC_ENVIRONMENT=staging
NODE_ENV=staging

# Build Information
BUILD_DATE=""
VCS_REF=""
VERSION="staging"

# =============================================================================
# DOMAIN AND URL CONFIGURATION
# =============================================================================

# Public URLs (Replace with your actual staging domain)
NEXT_PUBLIC_APP_URL=https://staging.eventmanagement.com
NEXT_PUBLIC_API_URL=https://staging.eventmanagement.com/api/v1
NEXT_PUBLIC_WS_URL=wss://staging.eventmanagement.com

# Internal URLs (for container communication)
INTERNAL_API_URL=http://backend:3000/api/v1

# CORS Configuration
CORS_ORIGIN=https://staging.eventmanagement.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Configuration
MONGODB_ROOT_USERNAME=staging_admin
MONGODB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_FOR_STAGING
MONGODB_DATABASE=staging_event_management
MONGODB_URI=mongodb://staging_admin:CHANGE_ME_STRONG_PASSWORD_FOR_STAGING@mongodb:27017/staging_event_management?authSource=admin

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=""  # Optional, for secured Redis

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# NextAuth Configuration
NEXTAUTH_URL=https://staging.eventmanagement.com
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN

# JWT Configuration
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_FOR_STAGING_ENV
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_FOR_STAGING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_FOR_STAGING

# Password Security
BCRYPT_SALT_ROUNDS=12

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# Google OAuth (Create staging app in Google Console)
GOOGLE_CLIENT_ID=your_google_client_id_for_staging
GOOGLE_CLIENT_SECRET=your_google_client_secret_for_staging

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=your_github_client_id_for_staging
GITHUB_CLIENT_SECRET=your_github_client_secret_for_staging

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Cloudinary Configuration (Use separate staging account)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_staging_cloudinary_cloud
CLOUDINARY_CLOUD_NAME=your_staging_cloudinary_cloud
CLOUDINARY_API_KEY=your_cloudinary_api_key_staging
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_staging

# Email Configuration (Use staging email service)
EMAIL_FROM=noreply@staging.eventmanagement.com
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_staging_email_user
EMAIL_PASS=your_staging_email_password

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Settings
API_VERSION=v1
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000  # Requests per window

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SSL Configuration
SSL_EMAIL=admin@eventmanagement.com
STAGING_DOMAIN=staging.eventmanagement.com

# Security Headers
HELMET_ENABLED=true
CSRF_PROTECTION_ENABLED=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics and Monitoring
ENABLE_METRICS=true
PROMETHEUS_ENABLED=true

# Error Tracking (Use staging environment in Sentry)
SENTRY_DSN=your_sentry_dsn_for_staging
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_for_staging

# Analytics (Use staging GA property)
NEXT_PUBLIC_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID_FOR_STAGING

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Images (can use specific tags for staging)
BACKEND_IMAGE=ghcr.io/your-org/eventmgmt-backend:staging
FRONTEND_IMAGE=ghcr.io/your-org/eventmgmt-frontend:staging

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=""  # Optional S3 backup
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Slack Notifications (for deployment alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Email Notifications for Alerts
ALERT_EMAIL_TO=admin@eventmanagement.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles for Staging
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_FILE_UPLOAD=true
ENABLE_NOTIFICATIONS=true
ENABLE_ADVANCED_SEARCH=true

# Debug Features (Staging only)
ENABLE_DEBUG_TOOLBAR=true
ENABLE_API_DOCS=true
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# STAGING SPECIFIC CONFIGURATION
# =============================================================================

# Staging Environment Features
STAGING_BANNER_ENABLED=true
STAGING_BANNER_MESSAGE="This is a staging environment - Data may be reset"

# Development Tools (Staging only)
ENABLE_REDUX_DEVTOOLS=true
ENABLE_REACT_QUERY_DEVTOOLS=true

# Testing Configuration
SEED_TEST_DATA=true
RESET_DATABASE_ON_START=false

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Caching
REDIS_CACHE_TTL=3600  # 1 hour
API_CACHE_TTL=300     # 5 minutes

# Rate Limiting (more lenient for staging)
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# =============================================================================
# SECURITY NOTES
# =============================================================================

# Important: Before deploying to staging:
# 1. Change all passwords and secrets above
# 2. Use separate database and service accounts
# 3. Configure proper SSL certificates
# 4. Set up monitoring and alerting
# 5. Test backup and restore procedures
# 6. Configure proper CORS origins
# 7. Set up log aggregation
# 8. Configure error tracking
# 9. Test OAuth providers with staging URLs
# 10. Verify email delivery works