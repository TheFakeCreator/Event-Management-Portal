# =============================================================================
# Production Logging Configuration
# Event Management Portal - Winston Logger Configuration
# =============================================================================

# Log Levels (in order of priority)
# error: 0, warn: 1, info: 2, http: 3, verbose: 4, debug: 5, silly: 6

# =============================================================================
# Environment Configuration
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# File Logging Configuration
# =============================================================================
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs

# Error Logs
LOG_ERROR_FILENAME=error.log
LOG_ERROR_MAX_SIZE=10m
LOG_ERROR_MAX_FILES=10

# Combined Logs
LOG_COMBINED_FILENAME=combined.log
LOG_COMBINED_MAX_SIZE=20m
LOG_COMBINED_MAX_FILES=14

# =============================================================================
# Console Logging Configuration
# =============================================================================
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=false
LOG_CONSOLE_TIMESTAMP=true

# =============================================================================
# HTTP Request Logging
# =============================================================================
LOG_HTTP_ENABLED=true
LOG_HTTP_FILENAME=http.log
LOG_HTTP_MAX_SIZE=20m
LOG_HTTP_MAX_FILES=7

# =============================================================================
# Database Query Logging
# =============================================================================
LOG_DB_QUERIES=false
LOG_DB_SLOW_QUERIES=true
LOG_DB_SLOW_THRESHOLD=1000

# =============================================================================
# Security & Audit Logging
# =============================================================================
LOG_SECURITY_ENABLED=true
LOG_SECURITY_FILENAME=security.log
LOG_SECURITY_MAX_SIZE=10m
LOG_SECURITY_MAX_FILES=30

# Events to log for security
LOG_AUTH_ATTEMPTS=true
LOG_FAILED_LOGINS=true
LOG_PASSWORD_CHANGES=true
LOG_PERMISSION_CHANGES=true
LOG_DATA_ACCESS=true

# =============================================================================
# Performance & Metrics Logging
# =============================================================================
LOG_PERFORMANCE=true
LOG_RESPONSE_TIMES=true
LOG_MEMORY_USAGE=true
LOG_CPU_USAGE=true

# =============================================================================
# External Service Logging
# =============================================================================
LOG_CLOUDINARY_UPLOADS=true
LOG_EMAIL_SENDING=true
LOG_REDIS_OPERATIONS=false

# =============================================================================
# Log Rotation & Cleanup
# =============================================================================
LOG_ROTATION_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_COMPRESS_OLD_LOGS=true
LOG_CLEANUP_SCHEDULE="0 2 * * 0"

# =============================================================================
# Structured Logging Fields
# =============================================================================
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_LEVEL=true
LOG_INCLUDE_MESSAGE=true
LOG_INCLUDE_METADATA=true
LOG_INCLUDE_CORRELATION_ID=true
LOG_INCLUDE_USER_ID=true
LOG_INCLUDE_IP_ADDRESS=true
LOG_INCLUDE_USER_AGENT=true
LOG_INCLUDE_REQUEST_ID=true

# =============================================================================
# Log Aggregation & Monitoring
# =============================================================================
# ELK Stack Integration
ELK_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

# Fluentd Integration
FLUENTD_ENABLED=false
FLUENTD_HOST=fluentd
FLUENTD_PORT=24224

# Datadog Integration
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_api_key

# =============================================================================
# Alert Configuration
# =============================================================================
LOG_ALERTS_ENABLED=true
LOG_ERROR_THRESHOLD=10
LOG_ERROR_WINDOW_MINUTES=5
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# =============================================================================
# Development & Debug Settings (Set to false in production)
# =============================================================================
LOG_DEBUG_SQL=false
LOG_DEBUG_HTTP_BODIES=false
LOG_SENSITIVE_DATA=false

# =============================================================================
# Privacy & Compliance
# =============================================================================
LOG_PII_MASKING=true
LOG_GDPR_COMPLIANCE=true
LOG_ANONYMIZE_IPS=true

# Sensitive fields to mask in logs
MASKED_FIELDS=password,token,secret,apiKey,creditCard,ssn,email,phoneNumber

# =============================================================================
# Notes for Production
# =============================================================================
#
# 1. Log Levels:
#    - production: info or warn level recommended
#    - staging: info or verbose level for debugging
#    - development: debug or silly level for full visibility
#
# 2. File Rotation:
#    - Configure appropriate max file sizes based on disk space
#    - Set retention periods based on compliance requirements
#    - Monitor disk usage to prevent log files from filling disk
#
# 3. Security:
#    - Never log sensitive information (passwords, API keys, etc.)
#    - Implement log aggregation for centralized monitoring
#    - Set up alerts for critical errors and security events
#
# 4. Performance:
#    - Use asynchronous logging to avoid blocking operations
#    - Consider log sampling for high-traffic applications
#    - Monitor logging overhead on application performance
#
# 5. Compliance:
#    - Ensure log retention meets regulatory requirements
#    - Implement proper data masking for PII
#    - Consider log encryption for sensitive environments
#
# =============================================================================