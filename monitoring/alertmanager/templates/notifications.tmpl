{{- if ne .Status "firing" }}
**Resolved:** {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}
**Duration:** {{ sub .EndsAt.Unix .StartsAt.Unix | humanizeDuration }}
{{- end }}
{{- end }}
{{- end }}

{{ define "email.subject" }}
[Event Management Portal] {{ .GroupLabels.alertname }} - {{ .Status | title }}
