{{- end }}

{{ define "email.body" }}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Alert Notification</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .header { background: #f8f9fa; padding: 20px; border-radius: 5px; margin-bottom: 20px; }
        .alert { margin: 15px 0; padding: 15px; border-left: 4px solid; border-radius: 4px; }
        .critical { border-color: #dc3545; background-color: #f8d7da; }
        .warning { border-color: #ffc107; background-color: #fff3cd; }
        .resolved { border-color: #28a745; background-color: #d4edda; }
        .info { border-color: #17a2b8; background-color: #d1ecf1; }
        .label { font-weight: bold; }
        .timestamp { color: #6c757d; font-size: 0.9em; }
        .runbook { display: inline-block; background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; margin-top: 10px; }
        .footer { margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6; font-size: 0.9em; color: #6c757d; }
    </style>
</head>
<body>
    <div class="header">
        <h2>Event Management Portal Alert</h2>
        <p><strong>Status:</strong> {{ .Status | title }}</p>
        <p><strong>Time:</strong> {{ now.Format "2006-01-02 15:04:05 UTC" }}</p>
    </div>

    {{- range .Alerts }}
    <div class="alert {{ if eq .Labels.severity "critical" }}critical{{ else if eq .Labels.severity "warning" }}warning{{ else if eq .Status "resolved" }}resolved{{ else }}info{{ end }}">
        <h3>{{ .Annotations.summary }}</h3>
        
        <p><span class="label">Alert:</span> {{ .Labels.alertname }}</p>
        <p><span class="label">Description:</span> {{ .Annotations.description }}</p>
        <p><span class="label">Severity:</span> {{ .Labels.severity | default "unknown" }}</p>
        <p><span class="label">Environment:</span> {{ .Labels.environment | default "unknown" }}</p>
        <p><span class="label">Instance:</span> {{ .Labels.instance | default "unknown" }}</p>
        
        {{- if .Labels.team }}
        <p><span class="label">Team:</span> {{ .Labels.team }}</p>
        {{- end }}
        
        <p class="timestamp"><span class="label">Started:</span> {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}</p>
        
        {{- if ne .Status "firing" }}
        <p class="timestamp"><span class="label">Resolved:</span> {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}</p>
        <p class="timestamp"><span class="label">Duration:</span> {{ sub .EndsAt.Unix .StartsAt.Unix | humanizeDuration }}</p>
        {{- end }}
        
        {{- if .Annotations.runbook_url }}
        <p><a href="{{ .Annotations.runbook_url }}" class="runbook">View Runbook</a></p>
        {{- end }}
    </div>
    {{- end }}

    <div class="footer">
        <p>This alert was generated by the Event Management Portal monitoring system.</p>
        <p>
            <a href="{{ .ExternalURL }}">View in Alertmanager</a> |
            <a href="${GRAFANA_URL}/d/application-overview">View in Grafana</a> |
            <a href="${PROMETHEUS_URL}">View in Prometheus</a>
        </p>
    </div>
</body>
</html>
{{- end }}

{{ define "pagerduty.description" }}
