{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@backend/*": ["./packages/backend/src/*"],
      "@frontend/*": ["./packages/frontend/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/*.ts",
    "packages/*/*.tsx",
    "packages/*/*.js",
    "packages/*/*.jsx"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.next"]
}
