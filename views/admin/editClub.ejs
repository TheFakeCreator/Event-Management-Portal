<% layout('layouts/main') %>

<head>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css"
  />
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
  <style>
    /* Dark theme styles for Choices.js dropdowns */
    .choices {
      margin-bottom: 0;
      font-size: 0.875rem;
    }

    .choices__inner {
      min-height: 2.75rem;
      padding: 0.75rem;
      font-size: 0.875rem;
      border-radius: 0.5rem;
      border: 1px solid rgb(209, 213, 219);
      background-color: white;
      color: rgb(17, 24, 39);
      transition: all 0.3s ease;
    }

    .choices__inner:focus-within {
      outline: 2px solid rgb(96, 165, 250);
      outline-offset: -2px;
      border-color: rgb(96, 165, 250);
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
    }

    .choices__list--single .choices__item {
      padding: 0;
      margin: 0;
      display: flex;
      align-items: center;
    }

    .choices__placeholder {
      opacity: 0.7;
      color: rgb(107, 114, 128);
    }

    .choices__list--dropdown {
      border: 1px solid rgb(209, 213, 219);
      border-radius: 0.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1),
        0 4px 6px -2px rgba(0, 0, 0, 0.05);
      z-index: 1000;
      margin-top: 0.25rem;
    }

    .choices__list--dropdown .choices__item {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid rgb(243, 244, 246);
      transition: all 0.15s ease;
    }

    .choices__list--dropdown .choices__item:last-child {
      border-bottom: none;
    }

    .choices__item--choice:hover,
    .choices__item--choice.is-highlighted {
      background-color: rgb(239, 246, 255);
      color: rgb(59, 130, 246);
    }

    .choices__item--choice.is-selected {
      background-color: rgb(59, 130, 246);
      color: white;
    }

    .choices__input {
      background-color: rgb(249, 250, 251);
      border: 1px solid rgb(209, 213, 219);
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      margin: 0.5rem;
      width: calc(100% - 1rem);
      font-size: 0.875rem;
      color: rgb(17, 24, 39);
    }

    .choices__input:focus {
      outline: 2px solid rgb(96, 165, 250);
      outline-offset: -2px;
      border-color: rgb(96, 165, 250);
      background-color: white;
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
    }

    .choices__input::placeholder {
      color: rgb(156, 163, 175);
    }

    .choices[data-type*="select-one"] .choices__button {
      background-color: transparent;
      border: none;
      padding: 0 0.5rem;
      color: rgb(107, 114, 128);
      cursor: pointer;
    }

    .choices[data-type*="select-one"] .choices__button:hover {
      color: rgb(239, 68, 68);
    }

    .choices__inner::after {
      content: "";
      border-color: rgb(107, 114, 128) transparent transparent transparent;
      border-style: solid;
      border-width: 5px 4px 0 4px;
      right: 11.5px;
      top: 50%;
      margin-top: -2px;
      transition: transform 0.15s ease;
      pointer-events: none;
      position: absolute;
    }

    .choices.is-open .choices__inner::after {
      transform: rotate(180deg);
    }

    /* Dark theme overrides */
    .dark .choices__inner {
      background-color: rgb(31, 41, 55);
      border-color: rgb(75, 85, 99);
      color: rgb(243, 244, 246);
    }

    .dark .choices__inner:focus-within {
      border-color: rgb(96, 165, 250);
      outline-color: rgb(96, 165, 250);
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
    }

    .dark .choices__placeholder {
      color: rgb(156, 163, 175);
    }

    .dark .choices__list--dropdown {
      background-color: rgb(31, 41, 55);
      border-color: rgb(75, 85, 99);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3),
        0 4px 6px -2px rgba(0, 0, 0, 0.2);
    }

    .dark .choices__item--choice {
      background-color: rgb(31, 41, 55);
      color: rgb(243, 244, 246);
      border-bottom-color: rgb(55, 65, 81);
    }

    .dark .choices__item--choice:hover,
    .dark .choices__item--choice.is-highlighted {
      background-color: rgb(55, 65, 81);
      color: rgb(96, 165, 250);
    }

    .dark .choices__item--choice.is-selected {
      background-color: rgb(37, 99, 235);
      color: white;
    }

    .dark .choices__input {
      background-color: rgb(17, 24, 39);
      color: rgb(243, 244, 246);
      border-color: rgb(75, 85, 99);
    }

    .dark .choices__input:focus {
      outline-color: rgb(96, 165, 250);
      border-color: rgb(96, 165, 250);
      background-color: rgb(31, 41, 55);
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
    }

    .dark .choices__input::placeholder {
      color: rgb(156, 163, 175);
    }

    .dark .choices[data-type*="select-one"] .choices__button {
      color: rgb(156, 163, 175);
    }

    .dark .choices[data-type*="select-one"] .choices__button:hover {
      color: rgb(248, 113, 113);
    }

    .dark .choices__inner::after {
      border-top-color: rgb(156, 163, 175);
    }

    .choices__item--choice.has-no-choices {
      color: rgb(107, 114, 128);
      font-style: italic;
      padding: 1rem;
      text-align: center;
    }

    .dark .choices__item--choice.has-no-choices {
      color: rgb(156, 163, 175);
      background-color: rgb(31, 41, 55);
    }

    .choices {
      width: 100%;
    }

    .choices__inner {
      width: 100%;
      box-sizing: border-box;
    }

    .choices__spinner {
      border: 2px solid rgb(229, 231, 235);
      border-top-color: rgb(59, 130, 246);
    }

    .dark .choices__spinner {
      border-color: rgb(75, 85, 99);
      border-top-color: rgb(96, 165, 250);
    }
  </style>
</head>

<div
  class="max-w-6xl mx-auto p-4 sm:p-6 md:p-10 transition-colors duration-300"
>
  <h1
    class="text-3xl sm:text-4xl font-extrabold text-center text-blue-600 dark:text-primary-400 mb-6 sm:mb-8 transition-colors duration-300"
  >
    Edit Club
  </h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
    <!-- Edit Form -->
    <div
      class="bg-white dark:bg-dark-surface shadow-lg dark:shadow-2xl rounded-xl p-4 sm:p-6 border border-gray-200 dark:border-dark-border transition-colors duration-300"
    >
      <h2
        class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-dark-text-primary mb-4 sm:mb-6 transition-colors duration-300"
      >
        Update Club Details
      </h2>
      <form
        action="/admin/clubs/update/<%= club.id %>"
        method="POST"
        class="space-y-4 sm:space-y-6"
      >
        <div class="space-y-4 sm:space-y-6">
          <div>
            <label
              for="clubName"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              Club Name:
            </label>
            <input
              type="text"
              id="clubName"
              name="name"
              class="mt-2 w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
              value="<%= club.name %>"
              required
            />
          </div>

          <div>
            <label
              for="description"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              Description:
            </label>
            <textarea
              id="description"
              name="description"
              rows="3"
              class="mt-2 w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none resize-vertical transition-colors duration-300"
              required
            >
<%= club.description %></textarea
            >
          </div>

          <div>
            <label
              for="about"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              About:
            </label>
            <textarea
              id="about"
              name="about"
              rows="3"
              class="mt-2 w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none resize-vertical transition-colors duration-300"
            >
<%= club.about %></textarea
            >
          </div>

          <div>
            <label
              for="imageUrl"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              Image URL:
            </label>
            <input
              type="text"
              id="imageUrl"
              name="image"
              class="mt-2 w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
              value="<%= club.image %>"
              required
            />
          </div>

          <div>
            <label
              for="bannerUrl"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              Banner URL:
            </label>
            <input
              type="text"
              id="bannerUrl"
              name="banner"
              class="mt-2 w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
              value="<%= club.banner %>"
            />
          </div>
          <div>
            <label
              for="domains"
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary transition-colors duration-300"
            >
              Domains:
            </label>
            <div id="domainsContainer" class="mt-2 space-y-2">
              <% if (club.domains && club.domains.length) { %> <%
              club.domains.forEach(function(domain, idx) { %>
              <div class="flex gap-2">
                <input
                  type="text"
                  name="domains[]"
                  class="flex-1 p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                  value="<%= domain %>"
                />
                <button
                  type="button"
                  class="remove-domain bg-red-500 dark:bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-600 dark:hover:bg-red-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-red-500/50 dark:focus:ring-red-400/50"
                >
                  &times;
                </button>
              </div>
              <% }) %> <% } else { %>
              <div class="flex gap-2">
                <input
                  type="text"
                  name="domains[]"
                  class="flex-1 p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                  value=""
                />
                <button
                  type="button"
                  class="remove-domain bg-red-500 dark:bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-600 dark:hover:bg-red-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-red-500/50 dark:focus:ring-red-400/50"
                >
                  &times;
                </button>
              </div>
              <% } %>
            </div>
            <button
              type="button"
              id="addDomainBtn"
              class="mt-3 bg-green-500 dark:bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-600 dark:hover:bg-green-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 dark:focus:ring-green-400/50"
            >
              Add Domain
            </button>
          </div>
          <div>
            <label
              class="block text-sm sm:text-lg font-medium text-gray-700 dark:text-dark-text-primary mb-2 transition-colors duration-300"
            >
              Social Links:
            </label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <input
                type="email"
                name="social[email]"
                placeholder="Email"
                class="p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary placeholder-gray-500 dark:placeholder-dark-text-muted rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                value="<%= club.social?.email || '' %>"
              />
              <input
                type="text"
                name="social[instagram]"
                placeholder="Instagram"
                class="p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary placeholder-gray-500 dark:placeholder-dark-text-muted rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                value="<%= club.social?.instagram || '' %>"
              />
              <input
                type="text"
                name="social[facebook]"
                placeholder="Facebook"
                class="p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary placeholder-gray-500 dark:placeholder-dark-text-muted rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                value="<%= club.social?.facebook || '' %>"
              />
              <input
                type="text"
                name="social[linkedin]"
                placeholder="LinkedIn"
                class="p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary placeholder-gray-500 dark:placeholder-dark-text-muted rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
                value="<%= club.social?.linkedin || '' %>"
              />
              <input
                type="text"
                name="social[discord]"
                placeholder="Discord"
                class="p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary placeholder-gray-500 dark:placeholder-dark-text-muted rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300 md:col-span-2"
                value="<%= club.social?.discord || '' %>"
              />
            </div>
          </div>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto bg-blue-600 dark:bg-blue-700 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500/50 dark:focus:ring-blue-400/50 font-medium"
        >
          Update Club
        </button>
      </form>
    </div>
    <!-- Club Preview -->
    <div
      class="bg-white dark:bg-dark-surface shadow-lg dark:shadow-2xl rounded-xl p-4 sm:p-6 border border-gray-200 dark:border-dark-border transition-colors duration-300"
    >
      <h2
        class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-dark-text-primary mb-4 sm:mb-6 transition-colors duration-300"
      >
        Preview
      </h2>
      <div
        class="bg-white dark:bg-dark-card shadow-md rounded-lg p-4 transition transform hover:scale-[102%] hover:shadow-lg dark:hover:shadow-gray-900/50 border border-gray-100 dark:border-dark-border"
      >
        <!-- Club Image Preview -->
        <img
          id="previewImage"
          src="<%= club.image %>"
          alt="<%= club.name %> Banner"
          class="w-full h-40 object-cover rounded-lg transition-all duration-300"
        />

        <!-- Club Details -->
        <h3
          class="text-lg sm:text-xl font-semibold mt-3 text-gray-800 dark:text-dark-text-primary transition-colors duration-300"
        >
          <%= club.name %>
        </h3>
        <p
          class="text-gray-600 dark:text-dark-text-secondary mt-1 text-sm sm:text-base transition-colors duration-300"
        >
          <%= club.description %>
        </p>
      </div>
    </div>
  </div>

  <!-- Add Moderator Section -->
  <div
    class="bg-white dark:bg-dark-surface shadow-lg dark:shadow-2xl rounded-xl p-4 sm:p-6 mt-6 lg:mt-8 border border-gray-200 dark:border-dark-border transition-colors duration-300"
  >
    <h2
      class="text-lg sm:text-xl font-semibold text-gray-800 dark:text-dark-text-primary mb-4 sm:mb-6 transition-colors duration-300"
    >
      Add Moderator to this Club
    </h2>
    <form
      action="/admin/clubs/<%= club._id %>/add-moderator"
      method="POST"
      class="flex flex-col md:flex-row gap-4 items-end"
    >
      <div class="flex-1">
        <label
          for="moderatorSelect"
          class="block text-sm font-medium text-gray-700 dark:text-dark-text-primary mb-2 transition-colors duration-300"
        >
          Select User:
        </label>
        <select
          name="userId"
          id="moderatorSelect"
          class="w-full p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300"
          required
        >
          <option value="" disabled selected>Select a user</option>
          <% users && users.forEach(function(user) { %>
          <option value="<%= user._id %>">
            <%= user.name %> (<%= user.email %>)
          </option>
          <% }) %>
        </select>
      </div>
      <button
        type="submit"
        class="bg-green-600 dark:bg-green-700 text-white px-4 py-2 sm:px-6 sm:py-3 rounded-lg hover:bg-green-700 dark:hover:bg-green-800 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 dark:focus:ring-green-400/50 font-medium"
      >
        Add as Moderator
      </button>
    </form>
    <% if (club.moderators && club.moderators.length > 0) { %>
    <div class="mt-4 sm:mt-6">
      <h3
        class="font-semibold mb-3 text-gray-800 dark:text-dark-text-primary transition-colors duration-300"
      >
        Current Moderators:
      </h3>
      <div class="space-y-2">
        <% club.moderators.forEach(function(mod) { %>
        <div
          class="flex items-center justify-between p-3 bg-gray-50 dark:bg-dark-card rounded-lg border border-gray-200 dark:border-dark-border transition-colors duration-300"
        >
          <span
            class="text-gray-700 dark:text-dark-text-secondary transition-colors duration-300"
          >
            <%= mod.name || mod.email || mod.toString() %>
          </span>
          <form
            action="/admin/clubs/<%= club._id %>/remove-moderator"
            method="POST"
            class="inline"
          >
            <input type="hidden" name="userId" value="<%= mod._id %>" />
            <button
              type="submit"
              class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 text-sm font-medium transition-colors duration-300"
            >
              Remove
            </button>
          </form>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
  document.getElementById("bannerUrl").addEventListener("input", function () {
    const newImageUrl = this.value;
    const previewImage = document.getElementById("previewImage");

    // Update the preview image
    previewImage.src = newImageUrl || "<%= club.image %>";
  });

  // Initialize Choices.js for the moderator select dropdown
  document.addEventListener("DOMContentLoaded", function () {
    new Choices("#moderatorSelect", {
      searchEnabled: true,
      searchPlaceholderValue: "Search users by name or email...",
      noResultsText: "No users found",
      itemSelectText: "Press to select",
      removeItemButton: true,
    });
  }); // Add domain functionality
  document
    .getElementById("addDomainBtn")
    .addEventListener("click", function () {
      const container = document.getElementById("domainsContainer");
      const div = document.createElement("div");
      div.className = "flex gap-2";
      div.innerHTML = `
        <input 
          type="text" 
          name="domains[]" 
          class="flex-1 p-2 sm:p-3 border border-gray-300 dark:border-dark-border bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text-primary rounded-lg shadow-sm focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:outline-none transition-colors duration-300" 
          value="" 
        />
        <button 
          type="button" 
          class="remove-domain bg-red-500 dark:bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-600 dark:hover:bg-red-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-red-500/50 dark:focus:ring-red-400/50"
        >
          &times;
        </button>
      `;
      container.appendChild(div);
    });

  // Remove domain functionality
  document
    .getElementById("domainsContainer")
    .addEventListener("click", function (e) {
      if (e.target.classList.contains("remove-domain")) {
        const parent = e.target.closest("div");
        if (
          parent &&
          document.querySelectorAll("#domainsContainer input").length > 1
        ) {
          parent.remove();
        }
      }
    });
</script>
